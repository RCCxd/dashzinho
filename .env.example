# Copy to .env for local development. Never commit real values.
PORT=3000
NODE_ENV=development
# Localhost over plain HTTP only; application code also checks NODE_ENV and hostname.
INSECURE_LOCAL_COOKIES=true
DATABASE_URL=mysql://user:password@localhost:3306/dashboard2b
# Keep signup closed until the TiDB import and admin bootstrap are validated.
ALLOW_PUBLIC_SIGNUP=false
DATABASE_TLS=false
DB_CONNECTION_LIMIT=1
# Optional: generate a random 32+ character value and keep it only in the deployment secret store.
ADMIN_BOOTSTRAP_CODE=
